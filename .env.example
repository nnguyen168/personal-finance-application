# Copy to .env.local and fill in what you need. Everything is optional.

# Where the SQLite database lives (default ./data/hearth.db)
# DATABASE_PATH=./data/hearth.db

# Household password. Leave unset when running only on your own computer;
# ALWAYS set it before putting the app on the internet.
# APP_PASSWORD=choose-something-long
# AUTH_SECRET=a-random-64-char-string   # openssl rand -hex 32

# Enable Banking (automatic CCF sync) — see README "Connect CCF"
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_KEY_PATH=./secrets/enablebanking.pem
# or paste the key itself (\n for newlines):
# ENABLE_BANKING_PRIVATE_KEY=
# Public URL of the app, used for the bank redirect (defaults to the request host)
# PUBLIC_URL=https://budget.example.com

# Secret for scheduled syncs: POST /api/sync with "Authorization: Bearer <CRON_SECRET>"
# CRON_SECRET=

# Display settings
# NEXT_PUBLIC_CURRENCY=EUR
# NEXT_PUBLIC_LOCALE=fr-FR
# TZ_DISPLAY=Europe/Paris
